# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files -- the demo needs none of these to run; SESSION_SECRET remains a
# supported optional override for multi-instance hosting (see README.md).
.env*

# the generated cookie-sealing key (lib/calendar/secret.ts) -- a real secret,
# must be git-ignored before anything ever writes to it.
/.session-secret

# the operator's saved OAuth app client id/secret (lib/calendar/oauth-apps.ts)
# -- a real secret, must be git-ignored before anything ever writes to it.
/.oauth-apps.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
